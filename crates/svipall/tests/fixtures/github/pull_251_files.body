[{"sha":"944d1786725d335377d205c8be9c83772a3e3f4c","filename":"build.rs","status":"modified","additions":8,"deletions":2,"changes":10,"blob_url":"https://github.com/dtolnay/anyhow/blob/9aed850b49ecaf644cbe620c3b17e7447e8735d0/build.rs","raw_url":"https://github.com/dtolnay/anyhow/raw/9aed850b49ecaf644cbe620c3b17e7447e8735d0/build.rs","contents_url":"https://api.github.com/repos/dtolnay/anyhow/contents/build.rs?ref=9aed850b49ecaf644cbe620c3b17e7447e8735d0","patch":"@@ -70,8 +70,14 @@ fn compile_probe() -> Option<ExitStatus> {\n     let probefile = Path::new(&out_dir).join(\"probe.rs\");\n     fs::write(&probefile, PROBE).ok()?;\n \n-    // Make sure to pick up Cargo rustc configuration.\n-    let mut cmd = if let Some(wrapper) = env::var_os(\"RUSTC_WRAPPER\") {\n+    // Make sure to pick up Cargo rustc configuration, while working around\n+    // <https://github.com/rust-lang/rust-analyzer/issues/12973>.\n+    let wrapper = env::var_os(\"RUSTC_WRAPPER\").filter(|w| {\n+        let wrapper_filename = Path::new(w).file_name().unwrap_or_default();\n+        // Ignore wrappers with these filenames.\n+        wrapper_filename != \"rust-analyzer\" && wrapper_filename != \"rust-analyzer.exe\"\n+    });\n+    let mut cmd = if let Some(wrapper) = wrapper {\n         let mut cmd = Command::new(wrapper);\n         // The wrapper's first argument is supposed to be the path to rustc.\n         cmd.arg(rustc);"}]