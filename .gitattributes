# Line endings are normalised in the repository: LF is stored, and each checkout follows its own
# platform's convention. Without this, a contributor whose core.autocrlf is off commits CRLF and
# every later diff is the whole file rather than the lines they changed.
* text=auto

# Runs on Linux and macOS in CI, so it must stay LF even in a Windows checkout.
*.sh text eol=lf

# Binary assets git must not try to normalise.
*.png binary
*.ico binary
*.onnx binary

# Preserve captured experiment evidence and the bytes referenced by its hashes.
bench/experiments/automatic-public-20260906/** -text whitespace=cr-at-eol
bench/experiments/native-auto-20260906/** -text whitespace=cr-at-eol
bench/experiments/native-auto-candidate1-20260907/** -text whitespace=cr-at-eol
bench/experiments/native-auto-candidate2-20260907/** -text whitespace=cr-at-eol
bench/experiments/native-auto-extraction-20260907/** -text whitespace=cr-at-eol
bench/experiments/revalidation-20260906/** -text whitespace=cr-at-eol
