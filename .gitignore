/target/
bench/experiments/*/bin/
bench/experiments/*/runtime/
bench/experiments/*/state/
bench/experiments/*/state-*/
bench/experiments/*/source-before/
bench/experiments/*/source-before.zip
# Cargo.lock is committed: this workspace ships a binary, so builds must be reproducible.
.env
*.db
*.log
.idea/
.vscode/
.DS_Store
__pycache__/
# Embedded models are reproduced by tools/models/export.py, not carried in the tree.
crates/svipall-models/models/*.onnx
crates/svipall-models/models/*.json

# Extraction corpora. Third-party, large, and fetched on demand by
# scripts/fetch-*.sh. Never committed: WCXB is 193 MB, DAnIEL 176 MB and the
# TeCo forum archive unpacks to 13 GB.
/wcxb-corpus/
/daniel-corpus/
/teco-corpus/
/extraction-corpus/

# The demo GIF is committed; the frames it is built from are not.
docs/demo/.frames/
docs/demo/.stills/
