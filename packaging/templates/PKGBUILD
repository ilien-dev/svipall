pkgname=svipall-bin
# Arch forbids a hyphen in pkgver, and a semver pre-release is a hyphen by definition. `_` is the
# conventional stand-in; the tag and the artefact names keep the real string, so `_tag` carries it.
pkgver=@PKGVER@
_tag=v@VERSION@
pkgrel=1
pkgdesc="Local-first web scraping and captcha MCP server for AI agents"
arch=('x86_64' 'aarch64')
url="https://github.com/ilien-dev/svipall"
license=('AGPL-3.0-only')
provides=('svipall')
conflicts=('svipall')
# Not a dependency: the browser tiers want one, the http tier does not, and svipall can keep a
# Chrome for Testing of its own. `svipall doctor` says which situation you are in.
optdepends=('chromium: browser tiers and local captcha solving'
            'google-chrome: browser tiers and local captcha solving')
source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/$_tag/svipall-@VERSION@-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/$_tag/svipall-@VERSION@-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=('@SHA_X86_64_UNKNOWN_LINUX_GNU@')
sha256sums_aarch64=('@SHA_AARCH64_UNKNOWN_LINUX_GNU@')

package() {
    install -Dm755 "$srcdir/svipall" "$pkgdir/usr/bin/svipall"
    install -Dm755 "$srcdir/svipall-mcp" "$pkgdir/usr/bin/svipall-mcp"
    install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 "$srcdir/SKILL.md" "$pkgdir/usr/share/doc/$pkgname/SKILL.md"
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
